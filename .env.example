# ========= FinanceMCP 环境变量模板 =========
# 复制本文件为 .env ，填入真实值再启动
# （注：以 # 开头的行会被 dotenv 忽略，可放心写注释）

# === 数据源凭证（按需配置） ===
TUSHARE_TOKEN=YOUR_REAL_TUSHARE_TOKEN_HERE   # 去 https://tushare.pro/ 注册后获取

# Qveris 可选；不配置不会发起 Qveris 请求
# QVERIS_API_KEY=YOUR_QVERIS_API_KEY_HERE
# QVERIS_BASE_URL=https://qveris.ai/api/v1

# 多凭证同时存在时的数据源优先级；未列出的已知数据源会按默认顺序补齐
# FINANCE_SOURCE_PRIORITY=tushare,qveris,binance

# === 可选 ===
# NODE_ENV=development                       # dev / production，默认 dev
# API_URL=https://api.tushare.pro            # 如需代理或自建网关可改
# TIMEOUT=10000                              # 自定义超时，单位毫秒

# === 跨 Agent 模型缓存网关（完全可选，独立于现有 MCP） ===
# 推荐先执行 finance-cache init 生成配置与 Gateway API Key。
# CACHE_GATEWAY_CONFIG=C:/Users/you/.finance-mcp/cache-gateway.json
# CACHE_GATEWAY_HOST=127.0.0.1
# CACHE_GATEWAY_PORT=3210
# CACHE_GATEWAY_DATA_DIR=C:/Users/you/.finance-mcp/cache-gateway
# CACHE_GATEWAY_MASTER_KEY=32_BYTE_BASE64_OR_64_HEX_KEY
# CACHE_UPSTREAM_API_KEY=YOUR_MODEL_PROVIDER_API_KEY

# 不使用 JSON 配置时，可用下面的单模型快捷配置：
# CACHE_GATEWAY_API_KEY=KEY_SHARED_BY_TRAE_CURSOR_CLAUDE_CODE_CODEX
# CACHE_TENANT_ID=local
# CACHE_WORKSPACE_ID=FinanceMCP
# CACHE_MODEL_ALIAS=gpt-5.6-sol
# CACHE_UPSTREAM_MODEL=gpt-5.6-sol
# CACHE_UPSTREAM_BASE_URL=https://api.openai.com/v1
# CACHE_UPSTREAM_PROTOCOL=openai-responses     # openai-responses/openai-chat/anthropic
# CACHE_PROVIDER=openai                       # openai/anthropic/deepseek/generic/none
# CACHE_NATIVE_CACHE_MODE=explicit             # automatic/explicit

# ===========================================
