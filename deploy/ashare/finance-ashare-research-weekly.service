[Unit]
Description=FinanceMCP A-share weekly watchlist diagnosis (research cadence, read-only inputs)
After=docker.service network-online.target finance-ashare-daily.service finance-ashare-account-daily.service

[Service]
Type=oneshot
# Runs after the 21:10 / 21:15 jobs and the 21:40 ChatGPT deadline, never before them.
# ExecStart sets RESEARCH_CADENCE_ENABLED=1 inside run-research-cadence.sh; delete this unit to deactivate.
ExecStart=%h/workspace/FinanceMCP/deploy/ashare/run-research-cadence.sh weekly
TimeoutStartSec=900
Nice=10
IOSchedulingClass=idle
