# Copy to .env (chmod 600). Only the server environment supplies data-source credentials.
TUSHARE_TOKEN=
# Optional: require `Authorization: Bearer <token>` from MCP clients on the PUBLIC
# /mcp endpoint. Leave empty for ChatGPT "No authentication" connectors (the exposed
# tools are read-only local-cache market tools).
MCP_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Private account endpoint (/private/mcp) — AShareInvestor V1.0
# ---------------------------------------------------------------------------
# Strong random Bearer token for the private account endpoint. When empty the
# /private/mcp path is NOT mounted at all (it returns 404 and never advertises
# itself). Generate with:  openssl rand -hex 32
# The token is a secret: never commit it, never paste it into a report or log.
ASHARE_PRIVATE_PORTFOLIO_TOKEN=

# Host directory holding the private account ledger (portfolio.sqlite). Mode 700.
# Outside the market cache; never committed to Git.
#   ASHARE_PRIVATE_HOST_DIR=/home/jcshi/.local/share/ashare-private

# The customer-facing public MCP path stays /ashare/mcp -> this container. The
# private path is /private/mcp -> this same container (one service, two endpoints).

# ---------------------------------------------------------------------------
# OAuth 2.1 for ChatGPT custom connectors (/private/mcp)
# ---------------------------------------------------------------------------
# ChatGPT's connector UI offers OAuth / no-auth only; it has no static bearer
# token field. Enable OAuth so the private endpoint can be linked from ChatGPT.
ASHARE_OAUTH_ENABLED=0
# Issuer and canonical resource identifier. Both must be the public HTTPS origin
# that Caddy serves; ChatGPT echoes the resource value on authorize and token.
ASHARE_OAUTH_ISSUER=https://share.shijingchang.cn
ASHARE_OAUTH_RESOURCE=https://share.shijingchang.cn/private/mcp
# Password entered on the authorization page (single user, >= 12 chars).
# Generate with:  openssl rand -base64 24
# Never commit this value; it is a login secret, not an API token.
ASHARE_OAUTH_LOGIN_PASSWORD=
# Optional lifetimes (seconds). Defaults: access 3600, refresh 30 days.
# ASHARE_OAUTH_ACCESS_TOKEN_TTL=3600
# ASHARE_OAUTH_REFRESH_TOKEN_TTL=2592000
# OAuth state lives in the private directory (clients, codes, hashed tokens).
# ASHARE_OAUTH_DB_PATH=/private/oauth.sqlite

# When OAuth is enabled the legacy static token is rejected unless this is 1.
# Keep it 0 for production; set 1 only for local automation you control.
ASHARE_PRIVATE_ALLOW_STATIC_TOKEN=0
